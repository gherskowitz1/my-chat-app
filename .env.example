DATABASE_URL=postgresql://user:password@localhost:5432/chatapp
JWT_SECRET=change-this-to-a-random-secret
PORT=3001
CLIENT_URL=http://localhost:5173
# Optional — leave unset for open signup. When set, new accounts must enter
# this exact code to register (share it privately with whoever you invite).
SIGNUP_CODE=
# Optional — powers "forgot password" emails. If unset, or if a send ever
# fails, the reset link is printed to the server log instead so there's
# always a way to recover an account (check `railway logs` on the backend).
RESEND_API_KEY=your_resend_api_key
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
# Optional — leave unset to disable the GIF picker. Get a free key at
# https://developers.giphy.com (the Beta key works immediately, no review needed).
GIPHY_API_KEY=
# Optional — leave unset to disable Steam account linking / "currently
# playing" in the member list. Get a free key at
# https://steamcommunity.com/dev/apikey (requires a Steam account with a
# game on it and a phone number attached).
STEAM_API_KEY=
# Optional — leave unset to disable error alerts. Create a free project at
# https://sentry.io (platform: Node.js / Express) and paste its DSN here.
# The frontend has its own: set VITE_SENTRY_DSN on the frontend service
# (a separate Sentry project, platform: Browser JavaScript) — it's read at
# build time, so redeploy the frontend after adding it.
SENTRY_DSN=
